{
  "name": "app-anonimizador",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:brochure && next dev -H 127.0.0.1 -p 3300",
    "build": "pnpm build:brochure && next build",
    "build:brochure": "node scripts/copiar-brochure.mjs",
    "start": "next start -H 127.0.0.1 -p 3300",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:puente": "vitest run -c vitest.puente.config.ts",
    "test:e2e": "playwright test --pass-with-no-tests",
    "gate:anti-ia": "node scripts/gate-anti-ia.mjs",
    "kit:generar": "node docs/kit-de-prueba/generador.mjs",
    "velo": "tsx velo-local/velo.ts",
    "kit:base": "node docs/kit-de-prueba/kit-base.mjs",
    "prepare": "git config core.hooksPath githooks"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.78.0",
    "mssql": "^12.7.14",
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.10.0"
}
