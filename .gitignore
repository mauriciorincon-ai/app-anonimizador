# Renombrar a .gitignore al estampar la app
.claude/settings.local.json
node_modules/
.next/
out/
build/
coverage/
playwright-report/
test-results/
# Reportes crudos de `lhci collect` (un .json por corrida, ~1 MB). El CI los produce y los
# consume en el mismo job; correr el gate en local no debe ensuciar el árbol.
.lighthouseci/
# Datasets sintéticos generados por docs/kit-de-prueba/generador.mjs: se REGENERAN con su semilla
# (byte-idénticos), nunca se commitean — un CSV de 500k filas pesa 130 MB y el repo es público.
tmp/
.env
.env.local
.env.*.local
*.tsbuildinfo
.vercel/
.DS_Store
Thumbs.db

# design-sync (kit v1.10.0 no lo trae: lo añade el sync a Claude Design)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/entrada.css

# El brochure canónico vive en docs/; esta copia la genera scripts/copiar-brochure.mjs.
/public/conoce.html
